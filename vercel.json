{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/hermes",
      "destination": "/public/hermes.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
